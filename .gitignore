# Local .terraform directories (downloaded provider binaries/cache)
**/.terraform/*

# Terraform state files - contain resource IDs, IPs, and sometimes secrets in plaintext
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Variable files - likely to contain sensitive values (CIDRs, keys, account-specific data)
*.tfvars
*.tfvars.json

# Override files - used to override resources locally, not meant to be shared
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Saved plan output
*tfplan*

# Ignore CLI config files
.terraformrc
terraform.rc

# Generated SSH private key from this project - never commit this
*.pem